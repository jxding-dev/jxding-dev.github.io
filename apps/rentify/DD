8단계. 장비 상세 API 만들기
목표

장비 하나의 상세 정보를 가져옵니다.

equipmentRoutes.js에 추가합니다.

router.get("/:id", async (req, res) => {
  try {
    const { id } = req.params;

    const [rows] = await db.query(
      "SELECT * FROM equipment WHERE id = ?",
      [id]
    );

    if (rows.length === 0) {
      return res.status(404).json({ message: "장비를 찾을 수 없습니다." });
