const reserveForm = document.querySelector("#reserveForm");

const params = new URLSearchParams(location.search);
const equipmentId = params.get("id");

reserveForm.addEventListener("submit", async (event) => {
  event.preventDefault();

  const reservationData = {
    equipment_id: equipmentId,
    user_name: document.querySelector("#userName").value,
    phone: document.querySelector("#phone").value,
    start_date: document.querySelector("#startDate").value,
    end_date: document.querySelector("#endDate").value,
    purpose: document.querySelector("#purpose").value,
  };

  try {
    const response = await fetch("http://localhost:3000/api/reservations", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(reservationData),
    });

    const result = await response.json();
    alert(result.message);

    location.href = "./index.html";
  } catch (error) {
    console.error(error);
    alert("예약 신청 중 오류가 발생했습니다.");
  }
});
12단계. 관리자 예약 목록 API 만들기
목표

관리자가 전체 예약 목록을 확인합니다.

reservationRoutes.js에 추가합니다.

router.get("/", async (req, res) => {
  try {
    const [rows] = await db.query(`
      SELECT 
        reservations.id,
        reservations.user_name,
        reservations.phone,
        reservations.purpose,
        reservations.start_date,
        reservations.end_date,
        reservations.status,
        equipment.name AS equipment_name
      FROM reservations
      JOIN equipment
      ON reservations.equipment_id = equipment.id
      ORDER BY reservations.id DESC
    `);

    res.json(rows);
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: "예약 목록 조회 실패" });
  }
});

